//reverse_string
module reverse_string;

  string original = "Sivaparthasarathy";
  string reversed = "";

  initial begin
    for (int i = original.len()-1; i >= 0; i--)
      reversed = {reversed, original[i]};

    $display("Original = %s", original);
    $display("Reversed = %s", reversed);
  end

endmodule
